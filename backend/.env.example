# Copy to backend/.env for local development.
# Nothing here is a real secret; real values never enter git.

# ── HTTP ─────────────────────────────────────────────────────────────────────
PORT=3000

# The process must listen on the loopback address only. Everything else reaches
# it through `tailscale serve`. This is not a preference: binding anywhere else
# makes the Tailscale-User-Login header forgeable by anyone on the tailnet, and
# the whole authentication scheme collapses.
HOST=127.0.0.1

FRONTEND_URL=http://localhost:4200

# ── Identity ─────────────────────────────────────────────────────────────────
# Trust the Tailscale-User-Login header injected by `tailscale serve`.
# Only ever true when HOST is a loopback address.
TRUST_TAILSCALE_HEADER=false

# Development stand-in for that header. Ignored unless NODE_ENV=development.
DEV_USER_EMAIL=dev@localhost

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL="file:./atalaya.db"

# ── Prometheus ───────────────────────────────────────────────────────────────
# Reached over the tailnet from homeserver. atalaya stores no metrics of its
# own: every number and chart is a query against this.
PROMETHEUS_URL=http://127.0.0.1:9090

# Directory holding the file-based discovery JSON that atalaya regenerates.
# Point it anywhere writable in development — nothing reads it but Prometheus,
# which is not running here.
PROMETHEUS_TARGETS_DIR=./prometheus-targets

# ── Alertmanager ─────────────────────────────────────────────────────────────
# Only ever called to push a silence — everything else arrives the other way,
# via the webhook. Reached over the tailnet from homeserver, same as Prometheus.
ALERTMANAGER_URL=http://127.0.0.1:9093

# ── Notification channels ───────────────────────────────────────────────────
# AES-256-GCM key for channel credentials (SMTP passwords, bot tokens) at
# rest — reversible on purpose: atalaya has to hand the real value back to
# nodemailer/etc. on every send, so this is encryption, not password hashing.
# 32 bytes, base64: `openssl rand -base64 32`. Losing it makes every stored
# channel credential unrecoverable — back it up like any other secret.
ENCRYPTION_KEY=
