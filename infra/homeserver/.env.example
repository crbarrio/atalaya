# Copy to `.env` beside this file and fill both in. Compose reads it
# automatically; nothing else needs editing to install.

# Where the browser reaches atalaya: whatever `tailscale serve` publishes.
FRONTEND_URL=https://homeserver.<your-tailnet>.ts.net

# AES-256-GCM key for stored channel credentials: openssl rand -base64 32
# On an existing install this MUST be the key already in use — credentials are
# encrypted with it, not hashed, and a new one makes them unrecoverable.
ENCRYPTION_KEY=
